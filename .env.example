# Copy to .env and fill in. .env is git-ignored — never commit real values.

OPENAQ_API_KEY=your_rotated_key_here
OPENAQ_BASE_URL=https://api.openaq.org/v3
OPENAQ_PARAMETER_ID=2
OPENAQ_PARAMETER_NAME=pm25
OPENAQ_PARAMETER_UNIT=µg/m³
OPENAQ_PAGE_LIMIT=1000

# "local" for development (writes to ./data), "s3" for the deployed pipeline
STORAGE_BACKEND=local
S3_BUCKET=
S3_RAW_PREFIX=raw
S3_CURATED_PREFIX=curated
LOCAL_DATA_DIR=./data

AWS_REGION=us-east-1

MIN_VALID_VALUE=0
WHO_PM25_24H_GUIDELINE=15
